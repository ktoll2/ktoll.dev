---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{% include published-posts.html -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.author.name | xml_escape }} | Blog</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link rel="self" type="application/atom+xml" href="{{ '/feed.xml' | absolute_url }}"/>
  <link rel="alternate" type="text/html" href="{{ '/blog/' | absolute_url }}"/>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <updated>{% if published_posts.first %}{{ published_posts.first.last_modified_at | default: published_posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ site.url }}</uri>
  </author>
  {% for post in published_posts limit: 20 %}
    <entry>
      <title>{{ post.title | xml_escape }}</title>
      <link rel="alternate" type="text/html" href="{{ post.url | absolute_url }}"/>
      <id>{{ post.url | absolute_url }}</id>
      <published>{{ post.date | date_to_xmlschema }}</published>
      <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
      {% for category in post.categories %}
        <category term="{{ category | xml_escape }}"/>
      {% endfor %}
      {% for tag in post.tags %}
        <category term="{{ tag | xml_escape }}"/>
      {% endfor %}
      <summary>{{ post.description | default: post.excerpt | strip_html | strip_newlines | xml_escape }}</summary>
    </entry>
  {% endfor %}
</feed>
